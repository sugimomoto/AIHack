# このファイルをコピーして .env.local を作り、実際の値を入れる
#   cp .env.example .env.local
#
# .env.local は .gitignore 済み。コミットされない。
# 本番の値は Secret Manager で管理する（→ docs/architecture.md §5.4）

# === OrcaRouter ===
ORCAROUTER_API_KEY=sk-orca-xxxxxxxxxxxxxxxxxxxxxxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# モデル階層（→ docs/architecture.md §4.1）
MODEL_TIER_SMALL=openai/gpt-5-nano
MODEL_TIER_MEDIUM=openai/gpt-4.1-mini
MODEL_TIER_LARGE=openai/gpt-5.1

# === Google Cloud ===
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-northeast1

# === Firebase ===
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
